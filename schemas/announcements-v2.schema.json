{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/announcements-v2.schema.json",
  "title": "Bilingual Timetable Announcements",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "message",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "object",
            "required": [
              "en",
              "ro"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "ro": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "message": {
            "type": "object",
            "required": [
              "en",
              "ro"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "ro": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "symbolName": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
